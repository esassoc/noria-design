---
// noria-parcel-controls — the single filter card of the Parcel Discovery Tool.
//
// A white bordered card (4px corners — the theme caps radius) of two rows,
// divided by a hairline:
//   Row 1 (filters): three inline, compact (sm) single-select dropdowns clustered
//     on ONE line + a right-aligned Clear. No section label.
//   Row 2 (view + search): a 1fr·auto·1fr grid — far-left search | centered
//     Grid|Hybrid|Map toggle | empty. All controls are sm.
//
// Composed from legos — no hand-rolled inputs/buttons/cards:
//   - esa-select (.ts WC)               → each of the three single-select filters
//   - esa-button-toggle (.ts WC)        → the Grid | Hybrid | Map segmented toggle
//   - esa-text-field (.ts WC)           → the grid search field
//   - esa-filter-clear-button (.astro)  → the right-aligned "Clear Filters" ghost button
//
// Why esa-select (over esa-filter-dropdown): these are SINGLE-value parameters —
// pick one reporting period, one month, one measurement type. esa-filter-dropdown
// is a MULTI-select facet filter (checkboxes + "Clear all", and a 200px-clamped
// trigger label tuned for short tags) — the wrong control, and it truncated long
// values like "2026 Water Year". esa-select is the simple single-select: it shows
// the full chosen value, no checkboxes. The field name rides in the placeholder.
//
// This card wires NOTHING cross-component. It only exposes stable ids the parcel
// explorer reacts to: #parcel-view-toggle (change), #parcel-search (input/change),
// #parcel-clear (esa-filter-clear), and #filter-measurement (reserved). Setting the
// toggle options/default and the select defaults is intrinsic to this card, so it
// happens here; reacting to them lives on the page.
//
// bcn-lego-checked: composes esa-select + esa-button-toggle + esa-text-field
// + esa-filter-clear-button into one card. The only bespoke CSS is the two-row card
// shell (rows/border/grid) — layout only, no reinvented primitive.
import EsaFilterClearButton from '@esa/ecology/esa-filter-clear-button.astro';
import { REPORTING_PERIODS, MEASUREMENT_TYPES } from '../../data/parcels';

const reportingPeriodOptions = REPORTING_PERIODS.map((period) => ({
  label: period,
  value: period,
}));

// Water-year order (Oct–Sep), abbreviated, matching the production tool.
const MONTHS = [
  'All Months',
  'Oct',
  'Nov',
  'Dec',
  'Jan',
  'Feb',
  'Mar',
  'Apr',
  'May',
  'Jun',
  'Jul',
  'Aug',
  'Sep',
];
const monthOptions = MONTHS.map((month) => ({ label: month, value: month }));

const measurementOptions = MEASUREMENT_TYPES.map((type) => ({
  label: type.label,
  value: type.value,
}));
---

<div class="noria-parcel-controls">
  <div class="noria-parcel-controls__row noria-parcel-controls__row--filters">
    <esa-select
      class="noria-parcel-controls__filter"
      placeholder="Reporting Period"
      size="sm"
      options={JSON.stringify(reportingPeriodOptions)}
      data-default="2026 Water Year"
    ></esa-select>

    <esa-select
      class="noria-parcel-controls__filter noria-parcel-controls__filter--months"
      placeholder="Months"
      size="sm"
      options={JSON.stringify(monthOptions)}
      data-default="All Months"
    ></esa-select>

    <esa-select
      id="filter-measurement"
      class="noria-parcel-controls__filter noria-parcel-controls__filter--measurement"
      placeholder="Water Measurement Type"
      size="sm"
      options={JSON.stringify(measurementOptions)}
    ></esa-select>

    <span id="parcel-clear" class="noria-parcel-controls__clear">
      <EsaFilterClearButton label="Clear Filters" />
    </span>
  </div>

  <div class="noria-parcel-controls__row noria-parcel-controls__row--view">
    <esa-text-field
      id="parcel-search"
      class="noria-parcel-controls__search"
      placeholder="Search grid…"
      size="sm"
    ></esa-text-field>
    <esa-button-toggle
      id="parcel-view-toggle"
      class="noria-parcel-controls__toggle"
      size="sm"
    ></esa-button-toggle>
    <div class="noria-parcel-controls__spacer" aria-hidden="true"></div>
  </div>
</div>

<style>
  /* Card shell — a white bordered card of two rows divided by a hairline. The only
     bespoke CSS here; everything inside is a lego.
     bcn-lego-checked: layout-only card shell composing esa- legos. */
  .noria-parcel-controls {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-100);
  }

  .noria-parcel-controls__row {
    padding: var(--spacing-250) var(--spacing-400);
  }
  .noria-parcel-controls__row + .noria-parcel-controls__row {
    border-top: 1px solid var(--color-border);
  }

  /* Row 1 — Filters: three compact single-selects + right-aligned Clear, all on one
     line. nowrap keeps the cluster from breaking onto a second row. */
  .noria-parcel-controls__row--filters {
    display: flex;
    align-items: center;
    gap: var(--spacing-200);
    flex-wrap: nowrap;
  }
  /* esa-select is display:block with a 100%-width input, so each needs an explicit
     box. Widths are sized per-content to hold the longest value with no clipping —
     full visibility, no ellipsis. */
  .noria-parcel-controls__filter {
    flex: 0 0 auto;
    inline-size: 14rem;
  }
  .noria-parcel-controls__filter--months {
    inline-size: 11rem;
  }
  .noria-parcel-controls__filter--measurement {
    inline-size: 18rem;
  }
  .noria-parcel-controls__clear {
    margin-left: auto;
    display: inline-flex;
  }

  /* Row 2 — view + search: far-left search | centered toggle | empty. */
  .noria-parcel-controls__row--view {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--spacing-300);
  }
  .noria-parcel-controls__toggle {
    justify-self: center;
  }
  /* Search pinned to the far left of the row. */
  .noria-parcel-controls__search {
    justify-self: start;
    inline-size: clamp(12rem, 22vw, 18rem);
  }
</style>

<script>
  import '@esa/ecology/esa-select';
  import '@esa/ecology/esa-button-toggle';
  import '@esa/ecology/esa-text-field';

  // Inner Lucide SVG markup (the `paths` convention — no <svg> wrapper); inherits
  // currentColor so it flips to the accent on the selected segment.
  const views = [
    {
      value: 'grid',
      label: 'Grid',
      icon: "<path d='M3 12h.01'/><path d='M3 18h.01'/><path d='M3 6h.01'/><path d='M8 12h13'/><path d='M8 18h13'/><path d='M8 6h13'/>",
    },
    {
      value: 'hybrid',
      label: 'Hybrid',
      icon: "<rect width='18' height='18' x='3' y='3' rx='2'/><path d='M12 3v18'/>",
    },
    {
      value: 'map',
      label: 'Map',
      icon: "<path d='M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z'/><path d='M15 5.764v15'/><path d='M9 3.236v15'/>",
    },
  ];

  customElements.whenDefined('esa-button-toggle').then(() => {
    const toggle = document.getElementById('parcel-view-toggle') as
      | (HTMLElement & { options: typeof views; value: string })
      | null;
    if (!toggle) return;
    toggle.options = views;
    toggle.value = 'hybrid';
  });

  // esa-select is searchable (typeahead) by default; these are simple pick-one
  // filters, so make them plain selects, then apply each default through the
  // public `value` setter once the lego has upgraded.
  customElements.whenDefined('esa-select').then(() => {
    document.querySelectorAll('esa-select').forEach((node) => {
      const el = node as HTMLElement & { searchable: boolean; value: string };
      el.searchable = false;
      const def = el.getAttribute('data-default');
      if (def) el.value = def;
    });
  });
</script>
